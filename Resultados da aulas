def gerar_matriz_distancia(n, seed=42):
    """Gera matriz de distâncias aleatória para n cidades."""
    np.random.seed(seed)
    dist = np.random.randint(10, 100, size=(n, n))
    for i in range(n):
        dist[i][i] = 0
        dist[i] = dist[i]  # Pode ou não ser simétrica
    return dist


def calcular_custo_rota(rota, dist):
    """Calcula o custo total de uma rota no TSP."""
    custo = 0
    for i in range(len(rota) - 1):
        custo += dist[rota[i]][rota[i+1]]
    return custo


def tsp_forca_bruta(dist):
    """
    Resolve TSP por força bruta (enumeração de todas as permutações).
    
    COMPLEXIDADE: O(n!) - ULTRA-EXPONENCIAL
    
    Exemplos de crescimento:
    - 4 cidades: 3! = 6 rotas
    - 5 cidades: 4! = 24 rotas
    - 10 cidades: 9! = 362.880 rotas
    - 12 cidades: 11! = 39 milhões
    - 15 cidades: 14! = 87 bilhões 
    
    IMPRATICÁVEL para n > 12
    """
    n = len(dist)
    cidades = list(range(n))
    
    melhor_rota = None
    melhor_custo = float('inf')
    total_avaliadas = 0
    
    # Gera todas as permutações começando de 0
    for perm in itertools.permutations(range(1, n)):
        total_avaliadas += 1
        rota = [0] + list(perm) + [0]  # Volta ao ponto inicial
        custo = calcular_custo_rota(rota, dist)
        
        if custo < melhor_custo:
            melhor_custo = custo
            melhor_rota = rota
    
    return melhor_rota, melhor_custo, total_avaliadas


