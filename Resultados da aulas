def busca_aleatoria_rastrigin(iteracoes=10000, dominio=(-5.12, 5.12)):
    """
    Implementa Busca Aleatória (Monte Carlo) para minimizar Rastrigin.
    
    ESTRATÉGIA:
    - Gera N pontos completamente aleatórios no domínio
    - Avalia cada ponto
    - Mantém registro do melhor ponto encontrado
    - Sem nenhuma inteligência ou memória entre tentativas
    
    PROBLEMA:
    - Altamente ineficiente para funções complexas
    - A qualidade da solução melhora muito lentamente
    - Necessita de MUITO tempo computacional
    
    QUANDO USAR:
    - Baseline para comparar outros métodos
    - Quando nenhuma informação sobre a função é conhecida
    - Para problemas muito pequenos
    """
    print(f"\n🔄 Executando Busca Aleatória ({iteracoes} iterações)...")
    
    inicio = time.time()
    melhor_x = None
    melhor_y = None
    melhor_valor = float('inf')
    historico = []
    
    for i in range(iteracoes):
        x = random.uniform(dominio[0], dominio[1])
        y = random.uniform(dominio[0], dominio[1])
        valor = rastrigin_2d(x, y)
        
        if valor < melhor_valor:
            melhor_valor = valor
            melhor_x = x
            melhor_y = y
        
        if i % (iteracoes // 20) == 0:  # 20 pontos no histórico
            historico.append((i, melhor_valor, melhor_x, melhor_y))
    
    fim = time.time()
    tempo = fim - inicio
    
    print(f"   ✓ Melhor valor encontrado: {melhor_valor:.6f}")
    print(f"   ✓ Coordenadas: ({melhor_x:.4f}, {melhor_y:.4f})")
    print(f"   ✓ Erro (distância do ótimo): {melhor_valor:.6f}")
    print(f"   ✓ Tempo: {tempo:.4f}s")
    
    return melhor_x, melhor_y, melhor_valor, historico, tempo


def plotar_convergencia_aleatoria(historico):
    """Plota convergência da busca aleatória."""
    if not historico:
        return
    
    iteracoes = [h[0] for h in historico]
    valores = [h[1] for h in historico]
    
    plt.figure(figsize=(10, 5))
    plt.plot(iteracoes, valores, 'b-o', linewidth=2, markersize=6, label='Melhor valor')
    plt.axhline(y=0, color='r', linestyle='--', linewidth=2, label='Ótimo Global')
    plt.xlabel('Iterações', fontsize=12)
    plt.ylabel('Melhor Valor Encontrado', fontsize=12)
    plt.title('Convergência da Busca Aleatória na Função Rastrigin', fontsize=14, fontweight='bold')
    plt.legend(fontsize=11)
    plt.grid(True, alpha=0.3)
    plt.yscale('log')
    plt.tight_layout()
    plt.show()


