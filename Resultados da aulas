def mochila_forca_bruta(pesos, valores, capacidade):
    """
    Resolve o Problema da Mochila 0/1 por FORÇA BRUTA.
    
    CONCEITO:
    - Testa TODAS as possíveis combinações de itens
    - Para n itens: 2^n combinações possíveis
    - Encontra garantidamente a solução ótima
    
    COMPLEXIDADE: O(2^n) - EXPONENCIAL - impraticável para n > 20
    
    EXEMPLO: n=10 -> 1024 combinações | n=20 -> 1 milhão | n=30 -> 1 bilhão
    
    QUANDO USAR: Apenas para n pequeno (≤ 20) ou como "ground truth"
    """
    n = len(pesos)
    melhor_valor = 0
    melhor_combinacao = None
    
    total_combinacoes = 0
    for comb in itertools.product([0, 1], repeat=n):
        total_combinacoes += 1
        peso_total = sum(pesos[i] for i in range(n) if comb[i] == 1)
        
        if peso_total <= capacidade:
            valor_total = sum(valores[i] for i in range(n) if comb[i] == 1)
            if valor_total > melhor_valor:
                melhor_valor = valor_total
                melhor_combinacao = comb
    
    return melhor_valor, melhor_combinacao, total_combinacoes


