def rastrigin_2d(x, y):
    """
    Função Rastrigin 2D - Benchmark clássico em otimização.
    
    Características:
    - Múltiplos mínimos locais espalhados pelo domínio
    - Apenas 1 mínimo global em (0, 0)
    - Desafiadora para algoritmos de otimização simples
    
    Fórmula: f(x,y) = 20 + (x² - 10·cos(2π·x)) + (y² - 10·cos(2π·y))
    
    Domínio típico: [-5.12, 5.12] x [-5.12, 5.12]
    Mínimo Global: (0, 0) com f(0,0) = 0
    """
    termo_x = x**2 - 10 * np.cos(2 * np.pi * x)
    termo_y = y**2 - 10 * np.cos(2 * np.pi * y)
    return 20 + termo_x + termo_y


